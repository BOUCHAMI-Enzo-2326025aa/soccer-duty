# Copier ce fichier en .env (gitignoré) et renseigner de vraies valeurs.

# Clé de signature des tokens de connexion (app/security.py). Change tous
# les tokens émis en circulation si tu la changes (tout le monde devra se
# reconnecter). Génère-en une avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- AIDEN (assistant IA, voir app/aiden_bridge.py) ---
# Sans ANTHROPIC_API_KEY (ou OPENAI_API_KEY), AIDEN répond en mode simulé
# (réponses factices, sans appel LLM réel) — pratique en dev, à remplacer
# avant d'ouvrir le chatbot à de vrais joueurs.
AIDEN_ENV=dev
# Génère ces deux secrets avec la même commande que SECRET_KEY ci-dessus.
AIDEN_TOKEN_SECRET=change-me
AIDEN_CONTEXT_SECRET=change-me
AIDEN_PERSISTENCE=sqlite
AIDEN_DB_PATH=./aiden.db
ANTHROPIC_API_KEY=sk-ant-change-me
